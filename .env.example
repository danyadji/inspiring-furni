# URL WordPress/WooCommerce backend (server-side only, no NEXT_PUBLIC_ prefix)
WP_API_URL=

# WooCommerce REST API key with read-only permission
WC_READ_KEY=
WC_READ_SECRET=

# WooCommerce REST API key with order-write permission (separate key)
WC_ORDER_KEY=
WC_ORDER_SECRET=

# WhatsApp number for the store (safe to expose publicly)
NEXT_PUBLIC_WA_NUMBER=

# Set to "true" to use local sample data instead of WooCommerce API
USE_SAMPLE_DATA=

# Secret token for on-demand revalidation (/api/revalidate)
REVALIDATE_SECRET=

# Public canonical site URL (e.g. https://domainanda.com - no trailing slash)
NEXT_PUBLIC_SITE_URL=https://inspiringfurni.com

